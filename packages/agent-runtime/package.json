{
  "name": "@bb/agent-runtime",
  "version": "0.0.1",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./test": {
      "source": "./src/test/index.ts",
      "types": "./src/test/index.ts",
      "default": "./src/test/index.ts"
    }
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts --exclude '**/integration/**'",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@bb/domain": "workspace:*",
    "@bb/host-daemon-contract": "workspace:*",
    "@bb/process-utils": "workspace:*",
    "@bb/provider-driver-contract": "workspace:*",
    "@bb/provider-driver-helpers": "workspace:*",
    "@bb/provider-driver-sdk": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bb/agent-providers": "workspace:*",
    "@bb/test-helpers": "workspace:*",
    "@bb/tsconfig": "workspace:*",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@types/node": "^22.0.0",
    "bb-plugin-acp": "workspace:*",
    "bb-plugin-claude-code": "workspace:*",
    "bb-plugin-codex": "workspace:*",
    "bb-plugin-pi": "workspace:*",
    "tsx": "^4.23.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  }
}
