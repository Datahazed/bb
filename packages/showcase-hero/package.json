{
  "name": "@bb/showcase-hero",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "description": "Portable bb showcase carousel and the plugin Browse hero preset.",
  "sideEffects": [
    "./src/styles.css"
  ],
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles.css": "./src/styles.css"
  },
  "types": "./src/index.ts",
  "scripts": {
    "clean": "rimraf tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bb/shared-ui": "workspace:*",
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6"
  },
  "devDependencies": {
    "@bb/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "bb": {
    "pluginTailwindContent": [
      "src/**/*"
    ]
  }
}
