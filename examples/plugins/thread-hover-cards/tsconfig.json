{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2022"],
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vitest"],
    "paths": {
      "@bb/plugin-sdk": [
        "../../../packages/plugin-sdk/bundled-types/bb-plugin-sdk.d.ts"
      ],
      "@bb/plugin-sdk/app": [
        "../../../packages/plugin-sdk/bundled-types/bb-plugin-sdk-app.d.ts"
      ],
      "@bb/plugin-sdk/testing/app": [
        "../../../packages/plugin-sdk/bundled-types/bb-plugin-sdk-testing-app.d.ts"
      ]
    }
  },
  "include": [
    "app.tsx",
    "icons.ts",
    "markdown-preview.ts",
    "server.ts",
    "styles.ts",
    "test/app.test.mjs",
    "test/server.test.ts",
    "vitest.config.ts"
  ]
}
